{
  "manifest_version": 3,
  "name": "Better Island Living",
  "version": "2.2",
  "description": "Replace words/phrases with whatever you want. Configurable, with defaults.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better Island Living"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}